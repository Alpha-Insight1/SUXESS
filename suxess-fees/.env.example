NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: email receipts to parents (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Suxess Fees <onboarding@resend.dev>

# SMS receipts via Termii (https://termii.com)
TERMII_API_KEY=
TERMII_SENDER_ID=Suxess

# Set to true only after Termii Sender ID is approved
SMS_ENABLED=false


# Alpha AI assistant (optional — works without key using live DB tools)
# Prefer xAI Grok: https://console.x.ai
XAI_API_KEY=
# Or OpenAI
OPENAI_API_KEY=
# Optional model override (default: grok-2-latest or gpt-4o-mini)
AI_MODEL=
